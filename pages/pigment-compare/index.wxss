.compare-page {
  min-height: 100vh;
  background: #F5F6F8;
  padding: 24rpx 16rpx 60rpx;
  box-sizing: border-box;
}

.compare-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.compare-card {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 16rpx;
  padding: 20rpx 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s, box-shadow 0.15s;
}
.compare-card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 色卡 */
.compare-card-swatch-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}
.compare-card-swatch {
  width: 140rpx;
  height: 96rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
}
.swatch-empty {
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #BBB;
}

/* 色号行：品牌缩写 + 色号 */
.compare-card-no-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
  line-height: 28rpx;
}
.compare-card-brand-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #0F2447;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
/* 色号 */
.compare-card-no {
  font-size: 22rpx;
  color: #0052D9;
  font-weight: 500;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  line-height: 28rpx;
}

/* 中文名（主信息） */
.compare-card-cn {
  font-size: 26rpx;
  color: #181818;
  font-weight: 500;
  line-height: 36rpx;
  margin-bottom: 4rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

/* 英文名 */
.compare-card-en {
  font-size: 20rpx;
  color: #888;
  line-height: 28rpx;
  margin-bottom: 4rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  min-height: 28rpx;
}

/* 色料 */
.compare-card-pigment {
  font-size: 20rpx;
  color: #5F5E5A;
  line-height: 28rpx;
  margin-bottom: 4rpx;
  text-align: center;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

/* 透明度 */
.compare-card-transparency {
  font-size: 20rpx;
  color: #888;
  line-height: 28rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

/* 空态 */
.empty-wrap {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 底部 footer */
.compare-footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}
