<!-- 水彩品牌列表页（含色彩库 Tab） -->
<view class="page">

  <!-- 顶部主 Tabs：全部品牌 / 色彩库 / 未拥有 -->
  <view class="tabs">
    <view
      class="tab {{activeTab === 'all' ? 'active' : ''}}"
      data-tab="all"
      bindtap="onTabChange"
    >
      <view class="tab-label">全部品牌</view>
      <view class="tab-bar"></view>
    </view>
    <view
      class="tab {{activeTab === 'library' ? 'active' : ''}}"
      data-tab="library"
      bindtap="onTabChange"
    >
      <view class="tab-label">色彩库</view>
      <view class="tab-bar"></view>
    </view>
    <view
      class="tab {{activeTab === 'lottery' ? 'active lottery' : ''}}"
      data-tab="lottery"
      bindtap="onTabChange"
    >
      <view class="tab-label">今日签</view>
      <view class="tab-bar"></view>
    </view>
    <view
      class="tab {{activeTab === 'scheme' ? 'active scheme' : ''}}"
      data-tab="scheme"
      bindtap="onTabChange"
    >
      <view class="tab-label">色彩方</view>
      <view class="tab-bar"></view>
    </view>
  </view>

  <!-- ============ 模式 1：品牌视图（全部品牌） ============ -->
  <block wx:if="{{activeTab === 'all'}}">
    <view class="filter-bar">
      <view class="filter-item" bindtap="onSortTap">
        <text class="filter-label">排序</text>
        <text class="filter-value">{{sortLabel}}</text>
        <text class="filter-arrow">▼</text>
      </view>
      <view class="filter-count">共 {{filteredList.length}} 个品牌</view>
    </view>

    <scroll-view scroll-y class="list-scroll" enhanced show-scrollbar="{{false}}">
      <view class="list" wx:if="{{filteredList.length > 0}}">
        <view
          class="brand-card"
          wx:for="{{filteredList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onBrandTap"
          hover-class="card-hover"
          hover-stay-time="100"
        >
          <view class="brand-icon" style="background: {{item.color}}">
            <text class="brand-icon-text">{{item.iconText}}</text>
          </view>
          <view class="brand-info">
            <view class="brand-name-cn">{{item.nameCn}}</view>
            <view class="brand-name-en">{{item.nameEn}}</view>
          </view>
          <view class="brand-fraction {{item.ownedCount === 0 ? 'is-empty' : ''}} {{item.ownedCount > 0 && item.ownedCount === item.totalCount ? 'is-full' : ''}}">
            <text class="fraction-num">{{item.ownedCount}}</text>
            <view class="fraction-line"></view>
            <text class="fraction-den">{{item.totalCount}}</text>
          </view>
        </view>
        <view class="list-bottom-tip">— 已展示全部品牌 —</view>
      </view>
      <view class="empty-wrap" wx:else>
        <view class="empty-icon">📂</view>
        <view class="empty-text">暂无品牌数据</view>
      </view>
    </scroll-view>
  </block>

  <!-- ============ 模式 2：色彩库 Tab ============ -->
  <block wx:if="{{activeTab === 'library'}}">
    <!-- 子 Tab -->
    <view class="sub-tabs">
      <view class="sub-tab {{librarySubTab === 'owned' ? 'active' : ''}}" data-sub="owned" bindtap="onLibrarySubTab">
        <text class="sub-tab-text">已拥有 · {{stat.ownedCount}}</text>
      </view>
      <view class="sub-tab wishlist {{librarySubTab === 'wishlist' ? 'active' : ''}}" data-sub="wishlist" bindtap="onLibrarySubTab">
        <text class="sub-tab-text">★ 心愿单 · {{stat.wishlistCount}}</text>
      </view>
      <view class="sub-tab {{librarySubTab === 'unowned' ? 'active' : ''}}" data-sub="unowned" bindtap="onLibrarySubTab">
        <text class="sub-tab-text">未拥有 · {{stat.unownedCount}}</text>
      </view>
    </view>

    <!-- 操作栏：筛选 + 排序 + 对比（三段） -->
    <view class="action-bar" wx:if="{{!libCompareMode}}">
      <view class="action-btn {{activeFilterCount > 0 ? 'active' : ''}}" bindtap="onLibFilterTap" hover-class="action-hover">
        <text class="action-icon">⌒</text>
        <text class="action-text">筛选</text>
        <text wx:if="{{activeFilterCount > 0}}" class="action-badge">{{activeFilterCount}}</text>
      </view>
      <view class="action-divider"></view>
      <view class="action-btn" bindtap="onLibSortTap" hover-class="action-hover">
        <text class="action-icon">⇅</text>
        <text class="action-text">排序</text>
        <text class="action-sub">{{libSortLabel}}</text>
      </view>
      <view class="action-divider"></view>
      <view class="action-btn compare" bindtap="onLibCompareTap" hover-class="action-hover">
        <text class="action-icon">⊞</text>
        <text class="action-text">对比</text>
      </view>
    </view>

    <!-- 对比模式操作栏 -->
    <view class="action-bar compare-mode-bar" wx:if="{{libCompareMode}}">
      <view class="compare-exit" bindtap="onLibCancelCompare" hover-class="action-hover">
        <text class="compare-exit-text">× 退出对比</text>
      </view>
      <view class="compare-clear" bindtap="onLibClearCompare" hover-class="action-hover">
        <text class="compare-clear-text">⊘ 清空 ({{libCompareCount}})</text>
      </view>
    </view>

    <!-- 对比模式提示条 -->
    <view wx:if="{{libCompareMode}}" class="compare-hint-bar">
      <text class="compare-hint-text">⊞ 点击颜料加入对比</text>
    </view>

    <!-- 已应用筛选 chip 区 -->
    <view class="filter-chip-bar" wx:if="{{libActiveFilters.length > 0}}">
      <text class="filter-chip-label">已应用</text>
      <view
        class="filter-chip"
        wx:for="{{libActiveFilters}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onLibRemoveChip"
        hover-class="filter-chip-hover"
      >
        <text class="filter-chip-text">{{item.label}}</text>
        <text class="filter-chip-x">×</text>
      </view>
      <text class="filter-chip-count">命中 {{libFilteredTotal}}</text>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{libLoading}}" class="loading-tip">加载中…</view>

    <!-- 跨品牌颜料列表 -->
    <scroll-view
      scroll-y
      class="lib-scroll"
      bindscrolltolower="onLibScrollLower"
      lower-threshold="200"
      wx:if="{{!libLoading}}"
    >
      <view
        class="lib-row {{libCompareMode && item._compareSelected ? 'compare-selected' : ''}}"
        wx:for="{{libRendered}}"
        wx:key="_gid"
        data-gid="{{item._gid}}"
        bindtap="onLibRowTap"
        hover-class="row-hover"
        hover-stay-time="80"
      >
        <view class="lib-brand-icon" style="background: {{item._brandColor}}">
          <text class="lib-brand-abbr">{{item._brandAbbr}}</text>
          <text class="lib-brand-cn">{{item._brandCn}}</text>
        </view>
        <view class="lib-info">
          <view class="lib-name-cn">{{item.nameCn}}</view>
          <view class="lib-name-en">{{item.nameEn}}</view>
        </view>
        <view class="lib-meta">
          <view class="lib-color-no">{{item.colorNo}}</view>
          <view class="lib-pigment-trans">{{item._metaSub}}</view>
        </view>
        <view wx:if="{{!libCompareMode}}" class="lib-swatch-wrap">
          <image wx:if="{{item.swatchImage}}" class="lib-swatch lib-swatch-img" src="{{item.swatchImage}}" mode="aspectFill" lazy-load></image>
          <view wx:elif="{{item.swatch}}" class="lib-swatch" style="background: {{item.swatch}}"></view>
          <view wx:else class="lib-swatch lib-swatch-empty">—</view>
        </view>
        <view wx:if="{{libCompareMode}}" class="lib-compare-check">
          <view wx:if="{{item._compareSelected}}" class="lib-compare-checked">✓</view>
          <view wx:else class="lib-compare-unchecked"></view>
        </view>
      </view>

      <!-- 空态：筛选无命中 -->
      <view class="empty-filter-wrap" wx:if="{{libRendered.length === 0 && !libLoading && libIsFilterEmpty}}">
        <view class="empty-filter-icon">
          <text class="empty-filter-icon-glyph">⌕</text>
        </view>
        <view class="empty-filter-title">没有命中的颜料</view>
        <view class="empty-filter-desc">{{libEmptyDesc}}</view>
        <view class="empty-filter-chips" wx:if="{{libActiveFilters.length > 0}}">
          <view
            class="empty-filter-chip"
            wx:for="{{libActiveFilters}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onLibRemoveChip"
            hover-class="filter-chip-hover"
          >
            <text class="empty-filter-chip-prefix">清除</text>
            <text class="empty-filter-chip-label">{{item.label}}</text>
            <text class="empty-filter-chip-x">×</text>
          </view>
        </view>
        <view class="empty-filter-btn" bindtap="onLibClearAllFilters" hover-class="empty-filter-btn-hover">
          清除全部筛选
        </view>
      </view>

      <!-- 空态：子Tab本身无数据（非筛选导致） -->
      <view class="empty-wrap" wx:elif="{{libRendered.length === 0 && !libLoading}}">
        <view class="empty-icon">📂</view>
        <view class="empty-text">{{libEmptyText}}</view>
      </view>

      <view class="list-bottom-tip" wx:if="{{libRendered.length > 0}}">
        — 共 {{libFilteredTotal}} 条 —
      </view>
    </scroll-view>
  </block>

  <!-- ============ 模式 3：今日签 ============ -->
  <block wx:if="{{activeTab === 'lottery'}}">
    <scroll-view scroll-y class="lottery-scroll" enhanced show-scrollbar="{{false}}">
      <view class="lottery-page">

        <!-- 紧凑条件条（默认显示，含「⚙ 调整」入口） -->
        <view wx:if="{{!lotteryConfigExpanded}}" class="lottery-config-mini" bindtap="onLotteryConfigToggle" hover-class="lottery-config-mini-hover">
          <view class="lottery-config-mini-text">{{lotteryConfigMiniText}}</view>
          <view class="lottery-config-adjust-btn">
            <text class="lottery-config-adjust-icon">⚙</text>
            <text>调整</text>
          </view>
        </view>

        <!-- 展开式条件详细面板（点击调整后显示） -->
        <view wx:if="{{lotteryConfigExpanded}}" class="lottery-config">
          <view class="lottery-config-header">
            <text class="lottery-config-header-title">调整抽签条件</text>
            <view class="lottery-config-collapse-btn" bindtap="onLotteryConfigToggle">保存 ▴</view>
          </view>
          <view class="lottery-config-row">
            <view class="lottery-config-label">
              <view class="lottery-config-main">
                <text wx:if="{{lotteryConfig.dedupDays > 0}}"><text class="lottery-num">{{lotteryConfig.dedupDays}}</text> 日内不重复</text>
                <text wx:else><text class="lottery-num">0</text> 日不重复（当天可重复）</text>
              </view>
            </view>
            <view class="lottery-stepper">
              <view class="lottery-stepper-btn" data-delta="-1" bindtap="onLotteryDedupChange">−</view>
              <view class="lottery-stepper-value">{{lotteryConfig.dedupDays}}</view>
              <view class="lottery-stepper-btn" data-delta="1" bindtap="onLotteryDedupChange">+</view>
            </view>
          </view>
          <view class="lottery-config-divider"></view>
          <view class="lottery-config-row">
            <view class="lottery-config-label">
              <view class="lottery-config-main">抽取数量 <text class="lottery-num">{{lotteryConfig.count}}</text></view>
            </view>
            <view class="lottery-stepper">
              <view class="lottery-stepper-btn" data-delta="-1" bindtap="onLotteryCountChange">−</view>
              <view class="lottery-stepper-value">{{lotteryConfig.count}}</view>
              <view class="lottery-stepper-btn" data-delta="1" bindtap="onLotteryCountChange">+</view>
            </view>
          </view>
          <view class="lottery-config-divider"></view>
          <!-- 同品牌开关 -->
          <view class="lottery-config-row {{lotteryConfig.sameBrand ? 'lottery-config-row-active' : ''}}">
            <view class="lottery-config-label">
              <view class="lottery-config-main">同品牌</view>
            </view>
            <view class="lottery-switch {{lotteryConfig.sameBrand ? 'on' : ''}}" bindtap="onLotterySameBrandToggle">
              <view class="lottery-switch-knob"></view>
            </view>
          </view>
          <view class="lottery-config-tip">开启后本次抽签颜料将全部来自同一品牌（系统将随机选定一品牌后抽出）</view>
        </view>

        <!-- 抽取结果区（已抽签后） -->
        <view wx:if="{{lotteryHasResult}}" class="lottery-result">
          <view class="lottery-result-header">
            <view class="lottery-result-title">
              <text class="lottery-result-mark">签</text>今日抽中
            </view>
            <view class="lottery-result-meta">共 {{lotteryDrawn.length}} 个</view>
          </view>
          <view wx:if="{{lotteryEmpty}}" class="lottery-result-warn">{{lotteryEmpty}}</view>
          <view class="lottery-grid">
            <view
              class="lottery-card"
              wx:for="{{lotteryDrawn}}"
              wx:key="_gid"
              data-gid="{{item._gid}}"
              bindtap="onLotteryCardTap"
              hover-class="lottery-card-hover"
              hover-stay-time="80"
            >
              <view class="lottery-swatch" style="background: {{item.swatch || '#FAFAFA'}}">
                <text class="lottery-brand-badge">{{item._brandAbbr}}</text>
              </view>
              <view class="lottery-name">{{item.nameCn}}</view>
            </view>
          </view>
        </view>

        <!-- 中央抽签按钮（仅初始态） -->
        <view wx:if="{{!lotteryHasResult}}" class="lottery-center">
          <view class="lottery-hint">点 击 抽 签</view>
          <view
            class="lottery-btn {{ownedPoolCount === 0 ? 'disabled' : ''}} {{lotteryAnimating ? 'animating' : ''}}"
            bindtap="onLotteryDraw"
            hover-class="lottery-btn-hover"
            hover-stay-time="80"
          >
            <text class="lottery-btn-text">抽</text>
          </view>
          <view class="lottery-pool-hint">
            <text wx:if="{{ownedPoolCount > 0}}">已拥有 <text class="lottery-num">{{ownedPoolCount}}</text> 个颜料 · 可抽取池</text>
            <text wx:else class="lottery-pool-empty">先去标记几个已拥有的颜料 →</text>
          </view>
        </view>

        <!-- 底部操作（结果态） -->
        <view wx:if="{{lotteryHasResult}}" class="lottery-redraw-bar">
          <view class="lottery-redraw-btn secondary" bindtap="onLotteryHistoryTap" hover-class="action-hover">
            <text class="lottery-redraw-icon">📋</text>
            <text>抽签历史</text>
          </view>
          <view class="lottery-redraw-btn primary {{lotteryAnimating ? 'animating' : ''}}" bindtap="onLotteryRedraw" hover-class="action-hover">
            <text class="lottery-redraw-icon">↻</text>
            <text>重新抽签</text>
          </view>
        </view>

        <!-- 保存为色彩方案（V4 新增，紫色主按钮 + 进度条） -->
        <view wx:if="{{lotteryHasResult}}" class="lottery-save-section">
          <view
            class="lottery-save-btn {{lotterySaveDisabled ? 'disabled' : ''}}"
            bindtap="onLotterySaveTap"
            hover-class="{{lotterySaveDisabled ? '' : 'lottery-save-btn-hover'}}"
          >
            <text class="lottery-save-icon">{{lotterySaveDisabled ? '✓' : '+'}}</text>
            <text>{{lotterySaveDisabled ? '已保存到色彩方' : '保存为色彩方案'}}</text>
          </view>
          <view class="lottery-save-meta">
            <view class="lottery-save-meta-row">
              <text class="lottery-save-meta-label">已保存方案</text>
              <text class="lottery-save-meta-count">{{lotterySchemeCount}} / {{lotterySchemeMax}}</text>
            </view>
            <view class="lottery-save-bar">
              <view class="lottery-save-bar-fill" style="width: {{lotterySchemeProgress}}%"></view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>

  <!-- 抽签历史弹层 -->
  <view class="mask {{lotteryHistoryVisible ? 'show' : ''}}" bindtap="onLotteryHistoryClose">
    <view class="filter-panel filter-panel-tall {{lotteryHistoryVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="filter-sub-header">
        <text class="filter-back" bindtap="onLotteryHistoryClose">‹</text>
        <text class="filter-sub-title">抽签历史（最近 30 次）</text>
      </view>
      <scroll-view scroll-y class="filter-options-scroll">
        <view class="lottery-hist-item" wx:for="{{lotteryHistory}}" wx:key="time">
          <view class="lottery-hist-time">{{item.count}} 个 · {{item.time}}</view>
          <view class="lottery-hist-names">{{item.names}}</view>
        </view>
        <view class="filter-options-empty" wx:if="{{lotteryHistory.length === 0}}">还没有抽签记录</view>
      </scroll-view>
    </view>
  </view>

  <!-- ============ 模式 4：色彩方 ============ -->
  <block wx:if="{{activeTab === 'scheme'}}">
    <view class="scheme-page">
      <!-- 加载中 -->
      <view wx:if="{{libLoading}}" class="loading-tip">加载中…</view>

      <!-- 空态：还没有任何方案 -->
      <view wx:elif="{{schemes.length === 0}}" class="scheme-empty">
        <view class="scheme-empty-icon">+</view>
        <view class="scheme-empty-title">还没有配色方案</view>
        <view class="scheme-empty-desc">创建你的第一个配色方案\n从喜欢的颜料组合开始</view>
        <view class="scheme-empty-btn" bindtap="onSchemeCreate" hover-class="scheme-empty-btn-hover">+ 新建方案</view>
      </view>

      <!-- 方案视图 -->
      <block wx:else>
        <!-- 顶部方案选择器 -->
        <scroll-view scroll-x class="scheme-selector" enhanced show-scrollbar="{{false}}">
          <view
            class="scheme-tab {{activeSchemeId === item.id ? 'active' : ''}}"
            wx:for="{{schemes}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onSchemeTabTap"
            hover-class="scheme-tab-hover"
          >{{item.name}}</view>
          <view
            class="scheme-tab add-btn {{schemes.length >= 10 ? 'disabled' : ''}}"
            bindtap="onSchemeCreate"
            hover-class="scheme-tab-hover"
          >+</view>
          <view class="scheme-meta">{{schemes.length}} / 10</view>
        </scroll-view>

        <!-- 方案标题 + 编辑/删除/已保存徽章 -->
        <view class="scheme-header {{activeScheme.isSaved ? 'saved' : ''}}" wx:if="{{activeScheme}}">
          <view class="scheme-title-row">
            <view class="scheme-title">{{activeScheme.name}}</view>
            <!-- 编辑态显示 ✎ 重命名按钮 -->
            <view wx:if="{{!activeScheme.isSaved}}" class="scheme-title-edit-btn" bindtap="onSchemeRenameOpen" hover-class="scheme-icon-hover">✎</view>
            <!-- 已保存态显示 ✓ 已保存徽章 -->
            <view wx:else class="scheme-saved-badge">✓ 已保存</view>
            <view class="scheme-title-delete-btn" bindtap="onSchemeDeleteCurrent" hover-class="scheme-icon-hover">🗑</view>
          </view>
          <view class="scheme-stat">
            共 <text class="scheme-num">{{activeScheme.pigmentsList.length}}</text> 个颜料 ·
            <text class="scheme-num">{{activeScheme.ownedCount}}</text> 已拥有 ·
            <text class="scheme-num scheme-num-warn">{{activeScheme.unownedCount}}</text> 未拥有 · 上限 48
          </view>
          <view wx:if="{{activeScheme.isSaved}}" class="scheme-stat-saved">最后保存：{{activeScheme.savedAtStr}}</view>
        </view>

        <!-- 颜料网格 -->
        <scroll-view scroll-y class="scheme-grid-section" wx:if="{{activeScheme}}">
          <view class="scheme-grid">
            <view
              class="scheme-card {{!item.owned ? 'unowned' : ''}}"
              wx:for="{{activeScheme.pigmentsList}}"
              wx:key="_gid"
            >
              <!-- 仅编辑态显示 × 删除按钮 -->
              <view
                wx:if="{{!activeScheme.isSaved}}"
                class="scheme-card-delete"
                data-gid="{{item._gid}}"
                catchtap="onSchemeRemovePigment"
                hover-class="scheme-icon-hover"
              >×</view>
              <view wx:if="{{!item.owned}}" class="scheme-unowned-badge">未拥有</view>
              <view class="scheme-swatch" style="background: {{item.swatch || '#FAFAFA'}};">
                <text class="scheme-brand-badge">{{item._brandAbbr}}</text>
              </view>
              <view class="scheme-name">{{item.nameCn}}</view>
              <view class="scheme-color-no">{{item.colorNo}}</view>
            </view>
            <!-- 添加占位卡（仅编辑态 + 未达上限时显示） -->
            <view
              wx:if="{{!activeScheme.isSaved && activeScheme.canAdd}}"
              class="scheme-card-add"
              bindtap="onSchemeAddBrandOpen"
              hover-class="scheme-card-add-hover"
            >
              <view class="scheme-card-add-icon">+</view>
              <view class="scheme-card-add-text">添加颜料</view>
            </view>
          </view>
          <view wx:if="{{!activeScheme.isSaved && !activeScheme.canAdd}}" class="scheme-limit-tip">
            ⚠ 此方案已达 48 个上限，删除一些颜料才能继续添加
          </view>
          <!-- 已保存态空方案兜底 -->
          <view wx:if="{{activeScheme.isSaved && activeScheme.pigmentsList.length === 0}}" class="scheme-saved-empty">
            该方案暂无颜料，点击「修改方案」添加
          </view>
        </scroll-view>

        <!-- 底部操作栏：编辑态 vs 已保存态 -->
        <view class="scheme-footer" wx:if="{{activeScheme}}">
          <!-- 编辑态：保存方案 -->
          <block wx:if="{{!activeScheme.isSaved}}">
            <view class="scheme-footer-tip">还未保存 · 离开页面将丢失改动</view>
            <view class="scheme-footer-bar">
              <view class="scheme-footer-btn primary" bindtap="onSchemeSave" hover-class="scheme-footer-btn-hover">
                <text class="scheme-footer-icon">💾</text>
                <text>保存方案</text>
              </view>
            </view>
          </block>
          <!-- 已保存态：分享 + 修改方案 -->
          <block wx:else>
            <view class="scheme-footer-bar">
              <view class="scheme-footer-btn gray" bindtap="onSchemeShare" hover-class="scheme-footer-btn-hover">
                <text class="scheme-footer-icon">📤</text>
                <text>分享</text>
              </view>
              <view class="scheme-footer-btn outline" bindtap="onSchemeEnterEdit" hover-class="scheme-footer-btn-hover">
                <text class="scheme-footer-icon">✎</text>
                <text>修改方案</text>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>
  </block>

  <!-- 添加颜料 - Step 1 选品牌 -->
  <view class="mask {{schemeAddBrandVisible ? 'show' : ''}}" bindtap="onSchemeAddBrandClose">
    <view class="filter-panel filter-panel-tall scheme-popup {{schemeAddBrandVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="scheme-popup-header">
        <view class="scheme-popup-title">选择品牌</view>
        <view class="scheme-popup-step">第 1 步 / 共 2 步</view>
      </view>
      <scroll-view scroll-y class="filter-options-scroll">
        <view
          class="scheme-brand-row"
          wx:for="{{schemeAddBrandList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSchemeAddBrandTap"
          hover-class="scheme-brand-row-hover"
        >
          <view class="scheme-brand-icon" style="background: {{item.color}};">
            <text class="scheme-brand-abbr">{{item.iconText}}</text>
            <text class="scheme-brand-cn-mini">{{item.nameCn}}</text>
          </view>
          <view class="scheme-brand-info">
            <view class="scheme-brand-name">{{item.nameCn}}</view>
            <view class="scheme-brand-en">{{item.nameEn}} · {{item.colorCount}} 色</view>
          </view>
          <view class="scheme-brand-arrow">›</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 添加颜料 - Step 2 选色号 -->
  <view class="mask {{schemeAddColorVisible ? 'show' : ''}}" bindtap="onSchemeAddColorClose">
    <view class="filter-panel filter-panel-tall scheme-popup {{schemeAddColorVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="scheme-popup-header">
        <view class="scheme-popup-title">
          <text class="scheme-popup-back" bindtap="onSchemeAddColorBack">‹</text>
          {{schemeAddSelectedBrandName}} · 选色号
        </view>
        <view class="scheme-popup-step">第 2 步 / 共 2 步</view>
      </view>
      <view class="filter-search">
        <input
          class="filter-search-input"
          placeholder="搜索色号或名称（如 PB28 / 钴蓝）"
          value="{{schemeAddColorSearch}}"
          bindinput="onSchemeAddColorSearch"
        />
      </view>
      <scroll-view scroll-y class="filter-options-scroll">
        <view
          class="scheme-color-row {{item.added ? 'added' : ''}}"
          wx:for="{{schemeAddColorListFiltered}}"
          wx:key="_gid"
          data-gid="{{item._gid}}"
          bindtap="onSchemeAddColorTap"
          hover-class="scheme-color-row-hover"
        >
          <view class="scheme-color-swatch" style="background: {{item.swatch || '#FAFAFA'}};"></view>
          <view class="scheme-color-info">
            <view class="scheme-color-meta">
              <text class="scheme-color-no-tag">{{item.colorNo}}</text>
            </view>
            <view class="scheme-color-name">{{item.nameCn}}</view>
            <view class="scheme-color-en">{{item.nameEn}}</view>
          </view>
          <view wx:if="{{item.added}}" class="scheme-color-state added">已添加</view>
          <view wx:elif="{{item.owned}}" class="scheme-color-state owned">已拥有</view>
          <view wx:else class="scheme-color-state unowned">未拥有</view>
        </view>
        <view class="filter-options-empty" wx:if="{{schemeAddColorListFiltered.length === 0}}">无匹配颜料</view>
      </scroll-view>
    </view>
  </view>

  <!-- 重命名 dialog -->
  <view class="rename-mask {{schemeRenameVisible ? 'show' : ''}}" bindtap="onSchemeRenameClose">
    <view class="rename-dialog" catchtap="noop">
      <view class="rename-title">修改方案名称</view>
      <view class="rename-desc">名称将通过微信安全检测后保存</view>
      <input
        class="rename-input"
        placeholder="请输入方案名称"
        value="{{schemeRenameInput}}"
        bindinput="onSchemeRenameInput"
        maxlength="5"
        focus="{{schemeRenameVisible}}"
        confirm-type="done"
      />
      <view class="rename-tip">
        <text>{{schemeRenameInput.length}} / 5</text>
        <text wx:if="{{schemeRenameChecking}}" class="rename-checking">⏱ 安全检测中...</text>
      </view>
      <view class="rename-actions">
        <view class="rename-btn secondary" bindtap="onSchemeRenameClose" hover-class="rename-btn-hover">取消</view>
        <view
          class="rename-btn primary {{schemeRenameChecking ? 'loading' : ''}}"
          bindtap="onSchemeRenameSave"
          hover-class="rename-btn-hover"
        >保存</view>
      </view>
    </view>
  </view>

  <!-- 今日签 → 保存为色彩方案 命名 popup（底部抽屉） -->
  <view class="mask {{lotterySaveVisible ? 'show' : ''}}" bindtap="onLotterySaveClose">
    <view class="lottery-save-panel {{lotterySaveVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="lottery-save-title">保存为色彩方案</view>
      <view class="lottery-save-subtitle">将本次 {{lotteryDrawn.length}} 色保存到「色彩方」</view>

      <view class="lottery-save-field-label">
        <text>方案名称</text>
        <text class="lottery-save-field-count">{{lotterySaveInput.length}} / 5</text>
      </view>
      <input
        class="lottery-save-input"
        placeholder="请输入方案名称"
        value="{{lotterySaveInput}}"
        bindinput="onLotterySaveInput"
        maxlength="5"
        focus="{{lotterySaveVisible}}"
        confirm-type="done"
      />

      <view class="lottery-save-preview-label">本次抽取颜色</view>
      <scroll-view scroll-x class="lottery-save-preview" enhanced show-scrollbar="{{false}}">
        <view
          class="lottery-save-preview-item"
          wx:for="{{lotteryDrawn}}"
          wx:key="_gid"
          style="background: {{item.swatch || '#FAFAFA'}}"
        ></view>
      </scroll-view>

      <view class="lottery-save-tip">
        <text wx:if="{{lotterySaveChecking}}" class="rename-checking">⏱ 安全检测中...</text>
        <text wx:else>已用 {{lotterySchemeCount}} / {{lotterySchemeMax}} 个方案位</text>
      </view>

      <view class="lottery-save-actions">
        <view class="lottery-save-action-btn secondary" bindtap="onLotterySaveClose" hover-class="rename-btn-hover">取消</view>
        <view
          class="lottery-save-action-btn primary {{lotterySaveChecking ? 'loading' : ''}}"
          bindtap="onLotterySaveConfirm"
          hover-class="rename-btn-hover"
        >确认保存</view>
      </view>
    </view>
  </view>

  <!-- 今日签 → 方案数量已达上限 dialog -->
  <view class="rename-mask {{lotterySaveLimitVisible ? 'show' : ''}}" bindtap="onLotterySaveLimitClose">
    <view class="rename-dialog" catchtap="noop">
      <view class="lottery-limit-icon">!</view>
      <view class="rename-title">方案数量已达上限</view>
      <view class="lottery-limit-desc">色彩方最多保存 {{lotterySchemeMax}} 个方案，当前已有 {{lotterySchemeCount}} 个，请先到「色彩方」删除至少 1 个方案后再保存。</view>
      <view class="rename-actions">
        <view class="rename-btn secondary" bindtap="onLotterySaveLimitClose" hover-class="rename-btn-hover">我知道了</view>
        <view class="rename-btn lottery-limit-primary" bindtap="onLotterySaveLimitGoto" hover-class="rename-btn-hover">前往管理</view>
      </view>
    </view>
  </view>

  <!-- 排序弹层（品牌视图用） -->
  <view class="mask {{sortVisible ? 'show' : ''}}" bindtap="onSortClose">
    <view class="sort-panel {{sortVisible ? 'show' : ''}}" catchtap="noop">
      <view class="sort-header">
        <text class="sort-title">选择排序方式</text>
        <view class="sort-close" bindtap="onSortClose">✕</view>
      </view>
      <view class="sort-option" data-sort="name" bindtap="onSortChange">
        <text class="sort-option-label">按名称</text>
        <view class="radio {{sortType === 'name' ? 'checked' : ''}}"></view>
      </view>
      <view class="sort-option" data-sort="colorNo" bindtap="onSortChange">
        <text class="sort-option-label">按色号</text>
        <view class="radio {{sortType === 'colorNo' ? 'checked' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- 色彩库筛选主弹层 -->
  <view class="mask {{libFilterMainVisible ? 'show' : ''}}" bindtap="onLibFilterMainClose">
    <view class="filter-panel {{libFilterMainVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="filter-title">筛选条件</view>

      <view class="filter-row clickable" bindtap="onLibOpenBrandFilter" hover-class="filter-row-hover">
        <view class="filter-row-text">
          <view class="filter-row-label">按品牌</view>
          <view class="filter-row-sub">{{libFilterBrand ? libFilterBrandCn : '未选'}}</view>
        </view>
        <text class="filter-row-arrow">›</text>
      </view>

      <view class="filter-row clickable" bindtap="onLibOpenPigmentFilter" hover-class="filter-row-hover">
        <view class="filter-row-text">
          <view class="filter-row-label">按色料</view>
          <view class="filter-row-sub">{{libFilterPigment ? libFilterPigment : '未选'}}</view>
        </view>
        <text class="filter-row-arrow">›</text>
      </view>

      <view class="filter-row clickable" bindtap="onLibOpenTransFilter" hover-class="filter-row-hover">
        <view class="filter-row-text">
          <view class="filter-row-label">按透明度</view>
          <view class="filter-row-sub">{{libFilterTransLabel}}</view>
        </view>
        <text class="filter-row-arrow">›</text>
      </view>

      <view class="filter-actions">
        <view class="filter-btn secondary" bindtap="onLibFilterReset" hover-class="filter-btn-hover">重置</view>
        <view class="filter-btn primary" bindtap="onLibFilterApply" hover-class="filter-btn-hover">应用筛选</view>
      </view>
    </view>
  </view>

  <!-- 二级筛选 · 按品牌 -->
  <view class="mask {{libBrandPanelVisible ? 'show' : ''}}" bindtap="onLibBrandPanelClose">
    <view class="filter-panel {{libBrandPanelVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="filter-sub-header">
        <text class="filter-back" bindtap="onLibBrandPanelClose">‹</text>
        <text class="filter-sub-title">按品牌（单选）</text>
      </view>
      <view
        class="brand-option {{libBrandTemp === item.id ? 'selected' : ''}}"
        wx:for="{{brandsMeta}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onLibBrandOptionTap"
        hover-class="filter-option-hover"
      >
        <view class="brand-option-icon" style="background: {{item.color}}">
          <text class="brand-option-abbr">{{item.iconText}}</text>
        </view>
        <text class="brand-option-cn">{{item.nameCn}}</text>
        <text class="brand-option-count">· {{item.totalCount}} 个</text>
        <view class="radio {{libBrandTemp === item.id ? 'checked' : ''}}"></view>
      </view>
      <view class="filter-actions">
        <view class="filter-btn secondary" bindtap="onLibBrandClear" hover-class="filter-btn-hover">清除</view>
        <view class="filter-btn primary" bindtap="onLibBrandConfirm" hover-class="filter-btn-hover">确定</view>
      </view>
    </view>
  </view>

  <!-- 二级筛选 · 按色料 -->
  <view class="mask {{libPigmentPanelVisible ? 'show' : ''}}" bindtap="onLibPigmentPanelClose">
    <view class="filter-panel filter-panel-tall {{libPigmentPanelVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="filter-sub-header">
        <text class="filter-back" bindtap="onLibPigmentPanelClose">‹</text>
        <text class="filter-sub-title">按色料（单选）</text>
      </view>
      <view class="filter-search">
        <input
          class="filter-search-input"
          placeholder="搜索色料代码（如 PR108）"
          value="{{libPigmentSearchKey}}"
          bindinput="onLibPigmentSearchInput"
        />
      </view>
      <scroll-view scroll-y class="filter-options-scroll">
        <view
          class="filter-option {{libPigmentTemp === item.code ? 'selected' : ''}}"
          wx:for="{{libPigmentOptionsFiltered}}"
          wx:key="code"
          data-code="{{item.code}}"
          bindtap="onLibPigmentOptionTap"
          hover-class="filter-option-hover"
        >
          <view class="filter-option-text">
            <text class="filter-option-code">{{item.code}}</text>
            <text class="filter-option-count">{{item.count}} 个颜料</text>
          </view>
          <view class="radio {{libPigmentTemp === item.code ? 'checked' : ''}}"></view>
        </view>
        <view class="filter-options-empty" wx:if="{{libPigmentOptionsFiltered.length === 0}}">无匹配色料</view>
      </scroll-view>
      <view class="filter-actions">
        <view class="filter-btn secondary" bindtap="onLibPigmentClear" hover-class="filter-btn-hover">清除</view>
        <view class="filter-btn primary" bindtap="onLibPigmentConfirm" hover-class="filter-btn-hover">确定</view>
      </view>
    </view>
  </view>

  <!-- 二级筛选 · 按透明度 -->
  <view class="mask {{libTransPanelVisible ? 'show' : ''}}" bindtap="onLibTransPanelClose">
    <view class="filter-panel {{libTransPanelVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="filter-sub-header">
        <text class="filter-back" bindtap="onLibTransPanelClose">‹</text>
        <text class="filter-sub-title">按透明度（单选）</text>
      </view>
      <view
        class="trans-option {{libTransTemp === item.value ? 'selected' : ''}}"
        wx:for="{{libTransOptions}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onLibTransOptionTap"
        hover-class="filter-option-hover"
      >
        <view class="trans-option-left">
          <view class="trans-option-dot" style="background: {{item.dot}}"></view>
          <view>
            <view class="trans-option-cn">{{item.cn}}</view>
            <view class="trans-option-en">{{item.value}} · {{item.count}} 个</view>
          </view>
        </view>
        <view class="radio {{libTransTemp === item.value ? 'checked' : ''}}"></view>
      </view>
      <view class="filter-actions">
        <view class="filter-btn secondary" bindtap="onLibTransClear" hover-class="filter-btn-hover">清除</view>
        <view class="filter-btn primary" bindtap="onLibTransConfirm" hover-class="filter-btn-hover">确定</view>
      </view>
    </view>
  </view>

  <!-- 色彩库排序弹层 -->
  <view class="mask {{libSortVisible ? 'show' : ''}}" bindtap="onLibSortClose">
    <view class="sort-panel {{libSortVisible ? 'show' : ''}}" catchtap="noop">
      <view class="sort-header">
        <text class="sort-title">选择排序方式</text>
        <view class="sort-close" bindtap="onLibSortClose">✕</view>
      </view>
      <view class="sort-option" data-sort="colorNo" bindtap="onLibSortChange">
        <text class="sort-option-label">按色号</text>
        <view class="radio {{libSortType === 'colorNo' ? 'checked' : ''}}"></view>
      </view>
      <view class="sort-option" data-sort="brand" bindtap="onLibSortChange">
        <text class="sort-option-label">按品牌</text>
        <view class="radio {{libSortType === 'brand' ? 'checked' : ''}}"></view>
      </view>
      <view class="sort-option" data-sort="markedAt" bindtap="onLibSortChange">
        <text class="sort-option-label">按加入时间（最新在前）</text>
        <view class="radio {{libSortType === 'markedAt' ? 'checked' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- 颜料详情抽屉 V4（色彩库行点击拉起，与品牌详情页同款） -->
  <view class="mask {{drawerVisible ? 'show' : ''}}" bindtap="closeDrawer">
    <view class="drawer {{drawerVisible ? 'show' : ''}}" catchtap="noop">
      <view class="drawer-handle"></view>

      <!-- 头部：品牌 ICON + 颜料中文名/英文名/色号 chip -->
      <view class="drawer-header">
        <view class="drawer-brand-icon" style="background: {{drawerBrand.color}};">
          <text class="drawer-brand-abbr">{{drawerBrand.iconText}}</text>
          <text class="drawer-brand-cn">{{drawerBrand.nameCn}}</text>
        </view>
        <view class="drawer-meta">
          <view class="drawer-title-row">
            <text class="drawer-title">{{drawerPigment.nameCn}}</text>
            <view wx:if="{{drawerPigment.owned}}" class="drawer-badge owned">
              <text class="drawer-badge-icon">✓</text>
            </view>
          </view>
          <view class="drawer-en">{{drawerPigment.nameEn}}</view>
          <view class="drawer-chip-wrap">
            <text class="drawer-chip">{{drawerPigment.colorNo}}</text>
          </view>
        </view>
      </view>

      <!-- 色料 + 透明度 双栏 -->
      <view class="drawer-info-row">
        <view class="info-card info-card-half">
          <view class="info-label">色料</view>
          <view class="info-value mono">{{drawerPigment.pigment || '—'}}</view>
        </view>
        <view class="info-card info-card-half transparency-card">
          <view class="info-label">透明度</view>
          <view class="transparency-row">
            <view class="transparency-text">
              <view class="transparency-cn">{{drawerTransCn}}</view>
              <view class="transparency-en">{{drawerPigment.transparency || '—'}}</view>
            </view>
            <view class="transparency-dot" style="background: {{drawerTransDot}};"></view>
          </view>
        </view>
      </view>

      <!-- 色卡条 -->
      <view class="info-card swatch-card">
        <view class="info-label">色卡</view>
        <image wx:if="{{drawerPigment.swatchImage}}" class="swatch-bar swatch-bar-img" src="{{drawerPigment.swatchImage}}" mode="aspectFill"></image>
        <view wx:elif="{{drawerPigment.swatch}}" class="swatch-bar" style="background: {{drawerPigment.swatch}};"></view>
        <view wx:else class="swatch-bar swatch-bar-empty">无色卡</view>
      </view>

      <!-- 双行动按钮 -->
      <view class="drawer-actions">
        <view
          wx:if="{{drawerPigment.owned}}"
          class="drawer-action-btn wishlist disabled"
        >
          <text class="drawer-action-icon">★</text>
          <text class="drawer-action-text">加入心愿单</text>
        </view>
        <view
          wx:elif="{{drawerPigment.wishlist}}"
          class="drawer-action-btn wishlist active"
          bindtap="onDrawerToggleWishlist"
          hover-class="action-btn-hover"
        >
          <text class="drawer-action-icon">★</text>
          <text class="drawer-action-text">已加入心愿单</text>
        </view>
        <view
          wx:else
          class="drawer-action-btn wishlist"
          bindtap="onDrawerToggleWishlist"
          hover-class="action-btn-hover"
        >
          <text class="drawer-action-icon">★</text>
          <text class="drawer-action-text">加入心愿单</text>
        </view>

        <view
          class="drawer-action-btn owned-btn {{drawerPigment.owned ? 'secondary' : 'primary'}}"
          bindtap="onDrawerToggleOwned"
          hover-class="action-btn-hover"
        >
          <text class="drawer-action-icon">{{drawerPigment.owned ? '−' : '+'}}</text>
          <text class="drawer-action-text">{{drawerPigment.owned ? '取消拥有' : '标记为已拥有'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 色彩库对比模式底部横条 -->
  <view class="lib-compare-bar {{libCompareMode ? 'show' : ''}}">
    <view class="lib-compare-bar-left" bindtap="onLibCompareCartTap" hover-class="action-hover">
      <view class="lib-compare-bar-icon">
        <view class="lib-compare-cube"></view>
        <view class="lib-compare-cube"></view>
        <view class="lib-compare-cube"></view>
        <view class="lib-compare-cube"></view>
        <view wx:if="{{libCompareCount > 0}}" class="lib-compare-badge">{{libCompareCount > 99 ? '99+' : libCompareCount}}</view>
      </view>
      <view class="lib-compare-bar-info">
        <text class="lib-compare-bar-count">已选 {{libCompareCount}} 个颜料</text>
        <text class="lib-compare-bar-link">点击查看清单 ›</text>
      </view>
    </view>
    <view class="lib-compare-bar-btn" bindtap="onLibCompareConfirm" hover-class="action-hover">确定 →</view>
  </view>

  <!-- 色彩库对比清单 popup -->
  <view class="mask {{libCompareCartVisible ? 'show' : ''}}" bindtap="onLibCompareCartClose">
    <view class="filter-panel {{libCompareCartVisible ? 'show' : ''}}" catchtap="noop">
      <view class="filter-handle"></view>
      <view class="compare-cart-title">已选颜料清单</view>
      <view class="compare-cart-subtitle">共 {{libCompareCount}} 个 · 选好后点击确定进入对比</view>

      <scroll-view scroll-y class="compare-cart-list">
        <view
          class="compare-cart-row"
          wx:for="{{libCompareList}}"
          wx:key="_gid"
        >
          <view class="compare-cart-brand">{{item._brandAbbr || '?'}}</view>
          <view class="compare-cart-mid">
            <view class="compare-cart-no">{{item.colorNo}}</view>
            <view class="compare-cart-cn">{{item.nameCn}}</view>
          </view>
          <image wx:if="{{item.swatchImage}}" class="compare-cart-swatch compare-cart-swatch-img" src="{{item.swatchImage}}" mode="aspectFill"></image>
          <view wx:else class="compare-cart-swatch" style="background: {{item.swatch || '#FAFAFA'}}"></view>
          <view
            class="compare-cart-remove"
            data-gid="{{item._gid}}"
            catchtap="onLibCompareCartRemove"
            hover-class="compare-cart-remove-hover"
          >×</view>
        </view>
        <view wx:if="{{libCompareList.length === 0}}" class="compare-cart-empty">对比颜料为空</view>
      </scroll-view>

      <view class="filter-actions">
        <view class="filter-btn secondary" bindtap="onLibClearCompare" hover-class="filter-btn-hover">清空</view>
        <view class="filter-btn primary" bindtap="onLibCompareConfirm" hover-class="filter-btn-hover">确定 ({{libCompareCount}}) → 对比</view>
      </view>
    </view>
  </view>

  <!-- Toast -->
  <view class="toast {{toastVisible ? 'show' : ''}}">
    <text class="toast-icon">✓</text>
    <text class="toast-text">{{toastText}}</text>
  </view>
</view>
