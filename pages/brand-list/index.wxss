/* 水彩品牌列表页 */
.page {
  height: 100vh;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Tabs */
.tabs {
  display: flex;
  background: #FFFFFF;
  flex-shrink: 0;
}
.tab {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 0 0;
}
.tab-label {
  font-size: 30rpx;
  color: #666666;
  line-height: 42rpx;
  padding-bottom: 18rpx;
  transition: color 0.2s;
}
.tab-bar {
  width: 48rpx;
  height: 6rpx;
  background: transparent;
  border-radius: 4rpx;
  transition: background 0.2s;
}
.tab.active .tab-label {
  color: #0052D9;
  font-weight: 600;
}
.tab.active .tab-bar {
  background: #0052D9;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}
.filter-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #F5F7FA;
  border-radius: 32rpx;
}
.filter-label {
  font-size: 26rpx;
  color: #666666;
}
.filter-value {
  font-size: 26rpx;
  color: #0052D9;
  font-weight: 500;
  margin-left: 8rpx;
}
.filter-arrow {
  font-size: 18rpx;
  color: #666;
  margin-left: 8rpx;
}
.filter-count {
  font-size: 24rpx;
  color: #999999;
}

/* 列表区 */
.list-scroll {
  flex: 1;
  height: 0;
}
.list {
  padding: 24rpx 24rpx 40rpx;
}
.brand-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-hover {
  transform: scale(0.98);
  background: #FAFBFC;
}

/* 品牌占位 ICON */
.brand-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}
.brand-icon::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(0, 0, 0, 0.05));
}
.brand-icon-text {
  position: relative;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 品牌信息 */
.brand-info {
  flex: 1;
  min-width: 0;
}
.brand-name-cn {
  font-size: 32rpx;
  font-weight: 600;
  color: #181818;
  line-height: 44rpx;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.brand-name-en {
  font-size: 24rpx;
  color: #888888;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

/* 英文名 + 统计 一行 */
.brand-meta-row {
  display: flex;
  align-items: center;
  gap: 0;
  line-height: 32rpx;
}
.brand-meta-dot {
  color: #BBB;
  font-size: 22rpx;
  margin: 0 12rpx;
  flex-shrink: 0;
}
.brand-stat {
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.brand-stat-num {
  color: #BBBBBB;
  font-weight: 500;
}
.brand-stat-num.highlight {
  color: #0052D9;
}
.brand-stat-divider {
  color: #BBBBBB;
}

/* 状态图标 */
.brand-status {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.brand-status.owned {
  background: #0052D9;
}
.brand-status.owned .status-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}
.brand-status.unowned {
  border: 2rpx solid #DCDCDC;
  background: #FFFFFF;
}
.brand-status.unowned .status-icon {
  color: #BBBBBB;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}

.list-bottom-tip {
  text-align: center;
  font-size: 22rpx;
  color: #BBBBBB;
  padding: 24rpx 0;
}

/* 空状态 */
.empty-wrap {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 排序弹层遮罩 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 100;
  visibility: hidden;
  transition: background 0.25s, visibility 0.25s;
  display: flex;
  align-items: flex-end;
}
.mask.show {
  background: rgba(0, 0, 0, 0.5);
  visibility: visible;
}

.sort-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.sort-panel.show {
  transform: translateY(0);
}

.sort-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.sort-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #181818;
}
.sort-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx 16rpx;
  line-height: 1;
}

.sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.sort-option:last-child {
  border-bottom: none;
}
.sort-option-label {
  font-size: 30rpx;
  color: #181818;
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #DCDCDC;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}
.radio.checked {
  border-color: #0052D9;
}
.radio.checked::after {
  content: '';
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #0052D9;
}

/* ==== 分数式拥有数（方案 B：完全拥有时加深蓝 + 圈层） ==== */
.brand-fraction {
  width: 88rpx;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  margin-left: 12rpx;
}
.fraction-num {
  font-size: 36rpx;
  line-height: 40rpx;
  font-weight: 500;
  color: #0052D9;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.fraction-line {
  width: 48rpx;
  height: 2rpx;
  background: #DDDDDD;
  margin: 4rpx 0;
}
.fraction-den {
  font-size: 22rpx;
  line-height: 28rpx;
  color: #999999;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
/* 未拥有：分子灰 */
.brand-fraction.is-empty .fraction-num {
  color: #BBBBBB;
}
/* 完全拥有：加深蓝 + 圈层徽章 */
.brand-fraction.is-full {
  border-color: #0052D9;
}
.brand-fraction.is-full .fraction-num {
  color: #03338C;
}
.brand-fraction.is-full .fraction-line {
  background: #0052D9;
}
.brand-fraction.is-full .fraction-den {
  color: #03338C;
}

/* ============ 色彩库 Tab 子 Tabs ============ */
.sub-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  gap: 12rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.sub-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 16rpx;
  background: #F5F7FA;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sub-tab .sub-tab-text {
  font-size: 24rpx;
  color: #888;
  font-weight: 500;
}
.sub-tab.active { background: #E6EFFF; }
.sub-tab.active .sub-tab-text { color: #0052D9; }
.sub-tab.wishlist.active { background: #FFF4E6; }
.sub-tab.wishlist.active .sub-tab-text { color: #D17B00; }

/* ============ 操作栏（色彩库） ============ */
.action-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  height: 88rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
}
.action-btn .action-icon { font-size: 26rpx; color: #555; line-height: 1; }
.action-btn .action-text { font-size: 26rpx; color: #181818; font-weight: 500; }
.action-btn .action-sub { font-size: 20rpx; color: #0052D9; margin-left: 6rpx; }
.action-btn.active .action-icon,
.action-btn.active .action-text { color: #0052D9; }
.action-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  background: #0052D9;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 14rpx;
  margin-left: 4rpx;
}
.action-divider { width: 1rpx; height: 40rpx; background: #EEEEEE; }
.action-hover { background: #F8F9FB; }

/* ============ chip 区 ============ */
.filter-chip-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}
.filter-chip-label { font-size: 22rpx; color: #999; }
.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #E6EFFF;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}
.filter-chip-text { font-size: 22rpx; color: #0052D9; font-weight: 500; }
.filter-chip-x { font-size: 24rpx; color: #0052D9; opacity: 0.6; line-height: 1; }
.filter-chip-hover { background: #CCDCF7 !important; }
.filter-chip-count { font-size: 22rpx; color: #888; margin-left: 4rpx; }

/* ============ 色彩库列表 ============ */
.lib-scroll { flex: 1; height: 0; background: #F5F5F5; }
.lib-row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: 12rpx 24rpx 0;
  padding: 24rpx 24rpx;
  border-radius: 14rpx;
}
.row-hover { background: #FAFAFA; }
.lib-brand-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.lib-brand-abbr { font-size: 24rpx; font-weight: 600; color: #FFFFFF; line-height: 1; }
.lib-brand-cn { font-size: 14rpx; color: #FFFFFF; opacity: 0.85; margin-top: 4rpx; line-height: 1; }
.lib-info { flex: 1.4; min-width: 0; margin-left: 24rpx; }
.lib-name-cn { font-size: 28rpx; color: #181818; font-weight: 500; line-height: 34rpx; }
.lib-name-en {
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 26rpx;
}
.lib-meta { flex: 1; min-width: 0; margin-left: 16rpx; }
.lib-color-no {
  font-size: 22rpx;
  color: #0052D9;
  background: #E6EFFF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  display: inline-block;
  font-weight: 500;
}
.lib-pigment-trans {
  font-size: 18rpx;
  color: #999;
  margin-top: 6rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lib-swatch-wrap {
  width: 88rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  margin-left: 16rpx;
}
.lib-swatch {
  width: 80rpx;
  height: 56rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}
.lib-swatch-empty {
  border: 2rpx dashed #DDDDDD;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #BBB;
}

/* ============ 筛选弹层 ============ */
.mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.mask.show { opacity: 1; pointer-events: auto; }
.filter-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.filter-panel.show { transform: translateY(0); }
.filter-panel-tall { height: 80vh; }
.filter-handle {
  width: 64rpx;
  height: 8rpx;
  background: #DCDCDC;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
  flex-shrink: 0;
}
.filter-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #181818;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}
.filter-row-text { flex: 1; min-width: 0; }
.filter-row-label { font-size: 28rpx; color: #181818; font-weight: 500; }
.filter-row-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.filter-row-arrow { font-size: 32rpx; color: #BBB; margin-left: 16rpx; }
.filter-row-hover { background: #ECEFF5 !important; }

.filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-shrink: 0;
}
.filter-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  flex: 1;
}
.filter-btn.secondary { background: #FFFFFF; border: 1rpx solid #DCDCDC; color: #555; }
.filter-btn.primary { background: #0052D9; color: #FFFFFF; font-weight: 500; flex: 2; }
.filter-btn-hover { opacity: 0.85; }

.filter-sub-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}
.filter-back { font-size: 40rpx; color: #888; padding: 0 12rpx; line-height: 1; }
.filter-sub-title { font-size: 30rpx; font-weight: 500; color: #181818; }

.filter-search { margin-bottom: 16rpx; flex-shrink: 0; }
.filter-search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.filter-options-scroll { flex: 1; height: 0; }
.filter-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.filter-option.selected { background: #F6F9FF; margin: 0 -16rpx; padding-left: 24rpx; padding-right: 24rpx; }
.filter-option-hover { background: #FAFBFC !important; }
.filter-option-text { display: flex; align-items: baseline; gap: 16rpx; }
.filter-option-code {
  font-size: 28rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-weight: 500;
  color: #181818;
}
.filter-option.selected .filter-option-code { color: #0052D9; }
.filter-option-count { font-size: 22rpx; color: #999; }
.filter-option.selected .filter-option-count { color: #0052D9; }
.filter-options-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #BBB;
}

.brand-option {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.brand-option.selected { background: #F6F9FF; }
.brand-option-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.brand-option-abbr { font-size: 18rpx; color: #FFFFFF; font-weight: 500; }
.brand-option-cn {
  font-size: 28rpx;
  color: #181818;
  font-weight: 500;
  margin-left: 16rpx;
}
.brand-option.selected .brand-option-cn { color: #0052D9; }
.brand-option-count { font-size: 22rpx; color: #999; margin-left: 8rpx; flex: 1; }
.brand-option.selected .brand-option-count { color: #0052D9; }

.trans-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.trans-option.selected { background: #F6F9FF; }
.trans-option-left { display: flex; align-items: center; gap: 20rpx; }
.trans-option-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.trans-option-cn { font-size: 28rpx; font-weight: 500; color: #181818; }
.trans-option.selected .trans-option-cn { color: #0052D9; }
.trans-option-en {
  font-size: 20rpx;
  color: #999;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  margin-top: 4rpx;
}
.trans-option.selected .trans-option-en { color: #0052D9; }

.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #DCDCDC;
  flex-shrink: 0;
  position: relative;
}
.radio.checked { border-color: #0052D9; background: #0052D9; }
.radio.checked::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 12rpx;
  height: 12rpx;
  background: #FFFFFF;
  border-radius: 50%;
}

.loading-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #999;
}

.toast {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.75);
  color: #FFFFFF;
  padding: 24rpx 40rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
  z-index: 1000;
}
.toast.show { opacity: 1; }
.toast-icon { color: #FFFFFF; font-size: 28rpx; }
.toast-text { font-size: 26rpx; color: #FFFFFF; }

/* ===== 颜料详情抽屉 V4（色彩库行点击拉起，与品牌详情页同款） ===== */
.drawer {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}
.drawer.show { transform: translateY(0); }

.drawer-handle {
  width: 64rpx;
  height: 8rpx;
  background: #DCDCDC;
  border-radius: 4rpx;
  margin: 0 auto 28rpx;
}

.drawer-header {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.drawer-brand-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}
.drawer-brand-abbr {
  font-size: 36rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1;
}
.drawer-brand-cn {
  font-size: 20rpx;
  color: #FFFFFF;
  opacity: 0.85;
  margin-top: 12rpx;
  line-height: 1;
}

.drawer-meta { flex: 1; min-width: 0; padding-top: 4rpx; }
.drawer-title-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.drawer-title { font-size: 36rpx; font-weight: 600; color: #181818; line-height: 1.2; }
.drawer-badge {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.drawer-badge.owned { background: #0052D9; }
.drawer-badge.owned .drawer-badge-icon { color: #FFFFFF; font-size: 22rpx; font-weight: bold; line-height: 1; }
.drawer-en { font-size: 26rpx; color: #888; line-height: 1.3; margin-bottom: 12rpx; }
.drawer-chip-wrap { display: flex; }
.drawer-chip {
  font-size: 22rpx; color: #0052D9; background: #E6EFFF;
  padding: 6rpx 16rpx; border-radius: 12rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace; font-weight: 500;
}

.info-card { background: #F5F7FA; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.info-label { font-size: 22rpx; color: #888; margin-bottom: 12rpx; }
.info-value { font-size: 28rpx; color: #181818; font-weight: 500; line-height: 1.3; }
.info-value.mono { font-family: "SF Mono", Menlo, Consolas, monospace; }

.transparency-card { margin-bottom: 32rpx; }
.transparency-row { display: flex; align-items: center; justify-content: space-between; }
.transparency-text { flex: 1; min-width: 0; }
.transparency-cn { font-size: 30rpx; color: #181818; font-weight: 500; line-height: 1.2; }
.transparency-en {
  font-size: 20rpx; color: #BBB; margin-top: 6rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}
.transparency-dot { width: 84rpx; height: 84rpx; border-radius: 50%; flex-shrink: 0; }

.drawer-info-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.info-card-half { flex: 1; margin-bottom: 0; min-width: 0; }
.info-card-half.transparency-card { margin-bottom: 0; }

.swatch-card { margin-bottom: 32rpx; }
.swatch-bar { width: 100%; height: 80rpx; border-radius: 14rpx; border: 1rpx solid rgba(0, 0, 0, 0.06); }
.swatch-bar-empty {
  border: 2rpx dashed #DDDDDD; background: #FAFAFA;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #BBBBBB;
}

.drawer-actions { display: flex; gap: 16rpx; }
.drawer-action-btn {
  flex: 1; height: 88rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 28rpx; transition: opacity 0.15s, background 0.15s; box-sizing: border-box;
}
.drawer-action-btn .drawer-action-icon { font-size: 30rpx; line-height: 1; }
.drawer-action-btn .drawer-action-text { font-size: 28rpx; font-weight: 500; }

.drawer-action-btn.wishlist { background: #FFFFFF; border: 2rpx solid #0052D9; }
.drawer-action-btn.wishlist .drawer-action-icon,
.drawer-action-btn.wishlist .drawer-action-text { color: #0052D9; }
.drawer-action-btn.wishlist.active { background: #FFF4E6; border-color: #FFA940; }
.drawer-action-btn.wishlist.active .drawer-action-icon,
.drawer-action-btn.wishlist.active .drawer-action-text { color: #D17B00; }
.drawer-action-btn.wishlist.disabled {
  background: #F5F5F5; border: 1rpx solid #DCDCDC; pointer-events: none;
}
.drawer-action-btn.wishlist.disabled .drawer-action-icon,
.drawer-action-btn.wishlist.disabled .drawer-action-text { color: #BBBBBB; }

.drawer-action-btn.owned-btn.primary { background: #0052D9; border: 2rpx solid #0052D9; }
.drawer-action-btn.owned-btn.primary .drawer-action-icon,
.drawer-action-btn.owned-btn.primary .drawer-action-text { color: #FFFFFF; }
.drawer-action-btn.owned-btn.secondary { background: #FFFFFF; border: 1rpx solid #DCDCDC; }
.drawer-action-btn.owned-btn.secondary .drawer-action-icon,
.drawer-action-btn.owned-btn.secondary .drawer-action-text { color: #555; }

.action-btn-hover { opacity: 0.85; }

/* ===== 色彩库筛选空态 ===== */
.empty-filter-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 64rpx 80rpx;
}
.empty-filter-icon {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: #F0F5FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  border: 2rpx dashed #BFCDE6;
}
.empty-filter-icon-glyph {
  font-size: 88rpx;
  color: #0052D9;
  line-height: 1;
  font-weight: 300;
}
.empty-filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #181818;
  line-height: 1.3;
  margin-bottom: 16rpx;
}
.empty-filter-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  text-align: center;
  margin-bottom: 36rpx;
  max-width: 520rpx;
}
.empty-filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  margin-bottom: 32rpx;
  max-width: 560rpx;
}
.empty-filter-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #DCDCDC;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #555;
}
.empty-filter-chip-prefix {
  font-size: 22rpx;
  color: #999;
}
.empty-filter-chip-label {
  font-size: 24rpx;
  color: #181818;
  font-weight: 500;
}
.empty-filter-chip-x {
  font-size: 26rpx;
  color: #999;
  margin-left: 4rpx;
  line-height: 1;
}
.empty-filter-btn {
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: 16rpx;
  border: 2rpx solid #0052D9;
  color: #0052D9;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}
.empty-filter-btn-hover {
  background: #F0F5FF;
  opacity: 0.9;
}

/* ===================== 今日签 Daily Lottery ===================== */
.lottery-scroll {
  flex: 1; height: 0;
  background: linear-gradient(180deg, #FFFAF0 0%, #FFF5E0 16%, #F5F5F5 60%);
}
.lottery-page { padding: 0 0 32rpx; }

/* 中式装饰：金色调 */
.tab.active.lottery .tab-bar { background: #C9A86A !important; }
.tab.active.lottery .tab-label { color: #181818; }

.lottery-num {
  color: #C9A86A;
  font-weight: 700;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  margin: 0 2rpx;
}

/* 紧凑条内的 lottery-num 不要外边距（避免挤断行） */
.lottery-config-mini .lottery-num {
  margin: 0 1rpx;
}

/* 详细配置卡（初始态） */
.lottery-config {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(201, 168, 106, 0.1);
  border: 1rpx solid rgba(201, 168, 106, 0.25);
}
.lottery-config-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.lottery-config-divider {
  height: 0;
  border-top: 1rpx dashed #F0E5CC;
  margin: 4rpx 0;
}
.lottery-config-label { flex: 1; min-width: 0; }
.lottery-config-main {
  font-size: 28rpx;
  color: #181818;
  font-weight: 500;
}
.lottery-config-sub {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 步进器 */
.lottery-stepper {
  display: flex;
  align-items: center;
  background: #FAF6EE;
  border-radius: 12rpx;
  overflow: hidden;
  margin-left: 16rpx;
}
.lottery-stepper-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C9A86A;
  font-size: 36rpx;
  font-weight: 600;
  user-select: none;
}
.lottery-stepper-btn:active { background: rgba(201, 168, 106, 0.15); }
.lottery-stepper-value {
  width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #181818;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}
.lottery-clear-btn {
  font-size: 22rpx;
  color: #C9A86A;
  padding: 8rpx 12rpx;
  margin-left: 8rpx;
}
.lottery-clear-btn:active { opacity: 0.6; }

/* 紧凑条件条（结果态/默认态共用） */
.lottery-config-mini {
  margin: 24rpx 24rpx 0;
  padding: 18rpx 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 168, 106, 0.25);
}
.lottery-config-mini-text {
  font-size: 22rpx;
  color: #555;
  line-height: 1.4;
  /* 强制单行 + 超出截断（兜底，正常应能容纳） */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 中央抽签按钮 */
.lottery-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0 60rpx;
}
.lottery-hint {
  font-size: 24rpx;
  color: #C9A86A;
  letter-spacing: 8rpx;
  margin-bottom: 32rpx;
}
.lottery-btn {
  width: 312rpx;
  height: 312rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 35% 30%, #FFE4B0 0%, #E8C97A 35%, #C9A86A 65%, #A07F45 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 24rpx 64rpx rgba(201, 168, 106, 0.45),
    inset 0 -8rpx 32rpx rgba(120, 80, 30, 0.3),
    inset 0 8rpx 16rpx rgba(255, 255, 255, 0.4);
  position: relative;
  transition: transform 0.2s;
}
.lottery-btn::before {
  content: "";
  position: absolute;
  top: -16rpx; left: -16rpx; right: -16rpx; bottom: -16rpx;
  border-radius: 50%;
  border: 4rpx dashed rgba(201, 168, 106, 0.45);
  animation: lottery-spin 30s linear infinite;
}
@keyframes lottery-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.lottery-btn-text {
  font-size: 160rpx;
  font-weight: 800;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  color: #FFFFFF;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.18);
  line-height: 1;
}
.lottery-btn-hover { transform: scale(0.95); }
.lottery-btn.disabled {
  background: #E5E5E5;
  box-shadow: none;
}
.lottery-btn.disabled .lottery-btn-text {
  color: #BBB;
  text-shadow: none;
}
.lottery-btn.disabled::before { border-color: #DDD; animation: none; }
.lottery-btn.animating { animation: lottery-shake 0.6s ease-in-out; }
@keyframes lottery-shake {
  0% { transform: rotate(0); }
  20% { transform: rotate(-15deg) scale(0.95); }
  40% { transform: rotate(20deg) scale(1.05); }
  60% { transform: rotate(-12deg) scale(0.97); }
  80% { transform: rotate(8deg) scale(1.02); }
  100% { transform: rotate(0); }
}

.lottery-pool-hint {
  font-size: 22rpx;
  color: #BBB;
  margin-top: 28rpx;
}
.lottery-pool-empty { color: #C9A86A; }

/* 抽取结果区 */
.lottery-result {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(201, 168, 106, 0.08);
  border: 1rpx solid rgba(201, 168, 106, 0.25);
}
.lottery-result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
.lottery-result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #181818;
  display: flex;
  align-items: center;
}
.lottery-result-mark {
  color: #C9A86A;
  font-family: "Songti SC", serif;
  margin-right: 8rpx;
  font-size: 32rpx;
}
.lottery-result-meta {
  font-size: 22rpx;
  color: #999;
}
.lottery-result-warn {
  background: #FFF5E0;
  border-left: 4rpx solid #C9A86A;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: #8B6914;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}

/* 关键：固定 3 列 + 1:1 正方形色卡（统一尺寸） */
.lottery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.lottery-card {
  background: #FAFBFD;
  border-radius: 16rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
}
.lottery-card-hover { transform: scale(0.97); transition: transform 0.15s; }
.lottery-swatch {
  width: 100%;
  /* aspect-ratio: 1 / 1; -- 微信小程序兼容性问题，用 padding-bottom 替代 */
  padding-bottom: 100%;
  height: 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.lottery-swatch::after {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.18), transparent);
  pointer-events: none;
}
.lottery-brand-badge {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  background: rgba(255,255,255,0.94);
  color: #181818;
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  letter-spacing: 0.4rpx;
  z-index: 2;
}
.lottery-name {
  font-size: 22rpx;
  color: #181818;
  font-weight: 500;
  line-height: 1.3;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
}

/* 底部双按钮 */
.lottery-redraw-bar {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 24rpx 0;
}
.lottery-redraw-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.lottery-redraw-btn.primary {
  background: linear-gradient(135deg, #E8C97A, #C9A86A);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(201, 168, 106, 0.3);
}
.lottery-redraw-btn.primary.animating { animation: lottery-pulse 0.6s ease-in-out; }
@keyframes lottery-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(0.96); }
}
.lottery-redraw-btn.secondary {
  background: #FFFFFF;
  border: 1rpx solid #DCDCDC;
  color: #555;
}
.lottery-redraw-icon { font-size: 28rpx; }

/* 抽签历史弹层条目 */
.lottery-hist-item {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.lottery-hist-time {
  font-size: 22rpx;
  color: #C9A86A;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.lottery-hist-names {
  font-size: 24rpx;
  color: #555;
  line-height: 1.4;
}

/* 紧凑条件条 - 布局覆盖（横向排列 + 调整按钮在右） */
.lottery-config-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.lottery-config-mini-hover { background: #FAF6EE !important; }
.lottery-config-mini-text { flex: 1; min-width: 0; }

/* 调整按钮：纯文字金色，无背景框（对照视觉稿截图） */
.lottery-config-adjust-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #C9A86A;
  font-weight: 500;
  flex-shrink: 0;
  padding: 4rpx 0;
  white-space: nowrap;
}
.lottery-config-adjust-icon {
  font-size: 22rpx;
  line-height: 1;
}

/* 展开面板头部 */
.lottery-config-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx dashed #F0E5CC;
}
.lottery-config-header-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #181818;
}
.lottery-config-collapse-btn {
  font-size: 22rpx;
  color: #C9A86A;
  padding: 4rpx 8rpx;
}
.lottery-config-collapse-btn:active { opacity: 0.6; }
