/* 水彩品牌列表页 */
.page {
  height: 100vh;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Tabs */
.tabs {
  display: flex;
  background: #FFFFFF;
  flex-shrink: 0;
}
.tab {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 0 0;
}
.tab-label {
  font-size: 30rpx;
  color: #666666;
  line-height: 42rpx;
  padding-bottom: 18rpx;
  transition: color 0.2s;
}
.tab-bar {
  width: 48rpx;
  height: 6rpx;
  background: transparent;
  border-radius: 4rpx;
  transition: background 0.2s;
}
.tab.active .tab-label {
  color: #0052D9;
  font-weight: 600;
}
.tab.active .tab-bar {
  background: #0052D9;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}
.filter-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #F5F7FA;
  border-radius: 32rpx;
}
.filter-label {
  font-size: 26rpx;
  color: #666666;
}
.filter-value {
  font-size: 26rpx;
  color: #0052D9;
  font-weight: 500;
  margin-left: 8rpx;
}
.filter-arrow {
  font-size: 18rpx;
  color: #666;
  margin-left: 8rpx;
}
.filter-count {
  font-size: 24rpx;
  color: #999999;
}

/* 列表区 */
.list-scroll {
  flex: 1;
  height: 0;
}
.list {
  padding: 24rpx 24rpx 40rpx;
}
.brand-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-hover {
  transform: scale(0.98);
  background: #FAFBFC;
}

/* 品牌占位 ICON */
.brand-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}
.brand-icon::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(0, 0, 0, 0.05));
}
.brand-icon-text {
  position: relative;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 品牌信息 */
.brand-info {
  flex: 1;
  min-width: 0;
}
.brand-name-cn {
  font-size: 32rpx;
  font-weight: 600;
  color: #181818;
  line-height: 44rpx;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.brand-name-en {
  font-size: 24rpx;
  color: #888888;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

/* 英文名 + 统计 一行 */
.brand-meta-row {
  display: flex;
  align-items: center;
  gap: 0;
  line-height: 32rpx;
}
.brand-meta-dot {
  color: #BBB;
  font-size: 22rpx;
  margin: 0 12rpx;
  flex-shrink: 0;
}
.brand-stat {
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.brand-stat-num {
  color: #BBBBBB;
  font-weight: 500;
}
.brand-stat-num.highlight {
  color: #0052D9;
}
.brand-stat-divider {
  color: #BBBBBB;
}

/* 状态图标 */
.brand-status {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.brand-status.owned {
  background: #0052D9;
}
.brand-status.owned .status-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}
.brand-status.unowned {
  border: 2rpx solid #DCDCDC;
  background: #FFFFFF;
}
.brand-status.unowned .status-icon {
  color: #BBBBBB;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}

.list-bottom-tip {
  text-align: center;
  font-size: 22rpx;
  color: #BBBBBB;
  padding: 24rpx 0;
}

/* 空状态 */
.empty-wrap {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 排序弹层遮罩 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 100;
  visibility: hidden;
  transition: background 0.25s, visibility 0.25s;
  display: flex;
  align-items: flex-end;
}
.mask.show {
  background: rgba(0, 0, 0, 0.5);
  visibility: visible;
}

.sort-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
.sort-panel.show {
  transform: translateY(0);
}

.sort-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.sort-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #181818;
}
.sort-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx 16rpx;
  line-height: 1;
}

.sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.sort-option:last-child {
  border-bottom: none;
}
.sort-option-label {
  font-size: 30rpx;
  color: #181818;
}

.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #DCDCDC;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}
.radio.checked {
  border-color: #0052D9;
}
.radio.checked::after {
  content: '';
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #0052D9;
}

/* ==== 分数式拥有数（方案 B：完全拥有时加深蓝 + 圈层） ==== */
.brand-fraction {
  width: 88rpx;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  margin-left: 12rpx;
}
.fraction-num {
  font-size: 36rpx;
  line-height: 40rpx;
  font-weight: 500;
  color: #0052D9;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.fraction-line {
  width: 48rpx;
  height: 2rpx;
  background: #DDDDDD;
  margin: 4rpx 0;
}
.fraction-den {
  font-size: 22rpx;
  line-height: 28rpx;
  color: #999999;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
/* 未拥有：分子灰 */
.brand-fraction.is-empty .fraction-num {
  color: #BBBBBB;
}
/* 完全拥有：加深蓝 + 圈层徽章 */
.brand-fraction.is-full {
  border-color: #0052D9;
}
.brand-fraction.is-full .fraction-num {
  color: #03338C;
}
.brand-fraction.is-full .fraction-line {
  background: #0052D9;
}
.brand-fraction.is-full .fraction-den {
  color: #03338C;
}
